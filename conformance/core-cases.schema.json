{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptsyntax.org/conformance/core-cases/0.1-draft",
  "title": "PromptSyntax Core parser cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "source", "options", "data_plane", "directives", "diagnostics"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "source": { "type": "string" },
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entities": { "$ref": "#/$defs/string_set" },
          "actions": { "$ref": "#/$defs/string_set" },
          "authoring_namespaces": { "$ref": "#/$defs/string_set" }
        }
      },
      "data_plane": { "type": "string" },
      "directives": { "$ref": "#/$defs/string_list" },
      "diagnostics": { "$ref": "#/$defs/string_list" }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": { "type": "string" }
    },
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
