{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptsyntax.org/conformance/core-differential-input/0.1-draft",
  "title": "PromptSyntax generated Core differential inputs",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "source", "options"],
    "properties": {
      "id": { "type": "string", "pattern": "^core-generated-[0-9]{6}$" },
      "name": { "type": "string", "minLength": 1 },
      "source": { "type": "string" },
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entities": { "$ref": "#/$defs/string_set" },
          "actions": { "$ref": "#/$defs/string_set" },
          "authoring_namespaces": { "$ref": "#/$defs/string_set" }
        }
      }
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
